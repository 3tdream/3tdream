# Copy to .env.local for development, and set the same names on the host.
# The site renders without any of these — only selling the bridge-agent
# repository needs them, and every route says which one is missing rather than
# answering 500.

# ── Stripe ──────────────────────────────────────────────────────────────────
# Secret key. sk_test_… while you are testing; the success page shows a
# "test mode" badge on its own so a test purchase cannot be mistaken for a sale.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook, from the endpoint you register in the
# Stripe dashboard. Without it the webhook refuses every call: an endpoint that
# grants repository access on an unverified request is an open door.
STRIPE_WEBHOOK_SECRET=

# ── Granting access ─────────────────────────────────────────────────────────
# A GitHub token that may add collaborators to the repository named in
# lib/course-product.ts.
#
# Use a FINE-GRAINED personal access token, scoped to that ONE repository, with
# Repository permissions -> Administration: Read and write (adding a
# collaborator is an admin operation). Nothing else — not "repo", which is every
# repository you can reach.
#
# Then the worst a leaked token can do is invite strangers to read one
# repository you were selling anyway. A classic token with the `repo` scope
# could push to all of them.
GITHUB_TOKEN=
# Set to 1 to log the invitation instead of sending it. For walking the flow
# without emailing a stranger.
GITHUB_GRANT_DRY_RUN=

# ── Where this deployment lives ─────────────────────────────────────────────
# Used to build Checkout's success and cancel URLs. Left empty, the request's
# own host is used, which is right on Vercel and right locally.
NEXT_PUBLIC_SITE_URL=

# ── Lead form (/api/lead) ────────────────────────────────────────────────────
# All four are optional. With none set, POST /api/lead still returns 202 and
# logs the full submission to the server console — the form never breaks in
# dev/staging because an integration wasn't configured (ADR-001).

# POSTed with the lead JSON if set. Any non-2xx or network error is logged and
# swallowed — the visitor still gets a 202.
LEAD_WEBHOOK_URL=
# Destination inbox for the Resend-delivered copy of the lead. Resend is only
# attempted when THIS and RESEND_API_KEY are BOTH set — setting only one is
# treated as "unconfigured" and a distinct line is logged so the half-set case
# doesn't go unnoticed.
LEAD_TO_EMAIL=
# https://resend.com API key. See LEAD_TO_EMAIL above for the pairing rule.
RESEND_API_KEY=
# Sender address for the Resend copy. Left empty, lib/lead-values.ts falls back
# to leads@3tdream.vercel.app; set it to an address on a domain verified in Resend.
LEAD_FROM_EMAIL=

# ── Build Notes subscribe (/api/subscribe, /api/subscribe/confirm) ─────────
# All three below are optional. With any one unset, POST /api/subscribe still
# returns 202 { ok: true, delivered: false } and logs a single
# "[subscribe] not configured" line — the footer form never breaks in
# dev/preview because a secret wasn't configured yet.

# Secret used to HMAC-SHA256-sign the confirm token (lib/subscribe-token.ts).
# Generate with e.g. `openssl rand -hex 32`. Required for ANY token to be
# issued or verified — without it, both /api/subscribe and
# /api/subscribe/confirm treat every token as invalid.
SUBSCRIBE_TOKEN_SECRET=
# Absolute origin used to build the confirm link mailed to the subscriber,
# e.g. https://3tdream.vercel.app. Falls back to the incoming request's own
# origin when unset, same convention as NEXT_PUBLIC_SITE_URL above.
SITE_URL=
# Resend API key, reused from the lead form above. Confirmation + owner-notice
# emails are only attempted when this and SUBSCRIBE_TOKEN_SECRET are both set.
# RESEND_API_KEY=
